[Unit]
Description=HomeOS Codex request worker
After=homeos.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/homeos
EnvironmentFile=/etc/homeos.env
ExecStart=/usr/bin/node /root/homeos/scripts/codex-worker.mjs
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/homeos /srv/homeos /var/lib/homeos /var/backups/homeos
