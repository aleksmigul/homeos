[Unit]
Description=The Annexation API
After=network.target

[Service]
Type=simple
User=homeos
Group=homeos
WorkingDirectory=/srv/homeos
Environment=NODE_ENV=production
Environment=API_HOST=127.0.0.1
Environment=API_PORT=4000
Environment=DATABASE_PATH=/var/lib/homeos/homeos.db
Environment=UPLOADS_PATH=/var/lib/homeos/uploads
EnvironmentFile=/etc/homeos.env
ExecStart=/usr/bin/node /srv/homeos/apps/api/dist/server.js
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/homeos
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
